{
  "name": "@nibleaf/root",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "turbo run build",
    "build:server": "turbo run build -F @nibleaf/server...",
    "build:worker": "turbo run build -F @nibleaf/worker...",
    "build:app": "turbo run build -F @nibleaf/app...",
    "dev": "turbo watch dev -F @nibleaf/server -F @nibleaf/worker -F @nibleaf/app",
    "dev:full": "turbo watch dev",
    "dev:server": "turbo watch dev -F @nibleaf/server...",
    "dev:app": "turbo watch dev -F @nibleaf/app...",
    "clean": "turbo run clean && git clean -xdf node_modules",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "node --test scripts/email-runtime.test.mjs scripts/ui-primitives.test.mjs scripts/service-signals.test.mjs && turbo run test",
    "check:dead-code": "knip --include files,dependencies,exports,types,duplicates --no-config-hints",
    "check:react": "react-doctor --project @nibleaf/app,@nibleaf/admin --no-dead-code --no-supply-chain --no-score --blocking error",
    "release:notes": "pnpm dlx changelogithub@14.0.0",
    "docs:check": "node scripts/check-docs.mjs",
    "theme-repository:fixture": "bun scripts/theme-repository-fixture.ts",
    "db:generate": "pnpm --filter @nibleaf/database generate",
    "db:migrate": "pnpm --filter @nibleaf/database migrate:dev",
    "db:deploy": "pnpm --filter @nibleaf/database migrate:deploy",
    "db:push": "pnpm --filter @nibleaf/database push",
    "db:seed": "pnpm --filter @nibleaf/server seed",
    "db:studio": "pnpm --filter @nibleaf/database studio",
    "domains:setup": "dotenv -e .env -- bun scripts/setup-local-domains.ts setup",
    "domains:add": "dotenv -e .env -- bun scripts/setup-local-domains.ts add-custom",
    "domains:list": "dotenv -e .env -- bun scripts/setup-local-domains.ts list",
    "domains:remove": "dotenv -e .env -- bun scripts/setup-local-domains.ts remove-custom",
    "domains:test": "dotenv -e .env -- bun scripts/setup-local-domains.ts test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@nibleaf/database": "workspace:*",
    "@nibleaf/tsconfig": "workspace:*",
    "knip": "6.34.0",
    "react-doctor": "0.9.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "tsx": "4.23.13",
    "ultracite": "7.10.7",
    "vitest": "^4.1.11"
  }
}
