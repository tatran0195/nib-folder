    "@nibleaf/email": "workspace:*",
    "@nibleaf/jobs": "workspace:*",
    "@nibleaf/logger": "workspace:*",
    "@nibleaf/qdrant": "workspace:*",
    "@nibleaf/search": "workspace:*",
    "@nibleaf/shared": "workspace:*",
    "@nibleaf/storage": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "bullmq": "^6.4.0",
    "fflate": "^0.8.2",
    "got": "16.0.0",
    "hono": "^4.13.13",
    "marked": "^18.1.1",
    "nodemailer": "^9.1.1",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.64.1",
    "postmark": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nibleaf/tsconfig": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.1",
    "dotenv-cli": "^11.0.0",
