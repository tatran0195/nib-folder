  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run with-env bun run --watch src/index.ts",
    "build": "tsdown",
    "start": "bun run src/index.ts",
    "with-env": "dotenv -e ../../.env --",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
