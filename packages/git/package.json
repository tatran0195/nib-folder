{
  "name": "@nibleaf/git",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Git repository sync, webhooks, reconciliation, and content import pipelines (Avkash architecture)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./git-webhook": "./src/git-webhook.ts",
    "./git-import": "./src/git-import.ts",
    "./workflow": "./src/workflow.ts",
    "./crypto": "./src/crypto.ts",
    "./reconcile": "./src/reconcile.ts",
    "./github": "./src/github.ts",
    "./github-importer": "./src/github-importer.ts",
    "./types": "./src/types.ts",
    "./keys": "./src/keys.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
