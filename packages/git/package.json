    "test": "vitest run"
  },
  "dependencies": {
    "@nibleaf/bullmq": "workspace:*",
    "@nibleaf/content": "workspace:*",
    "@nibleaf/database": "workspace:*",
    "@nibleaf/exports": "workspace:*",
    "@nibleaf/logger": "workspace:*",
    "@nibleaf/projects": "workspace:*",
    "@nibleaf/shared": "workspace:*",
    "@nibleaf/validators": "workspace:*",
    "@t3-oss/env-core": "^0.13.1",
    "got": "^14.4.6",
    "octokit": "^4.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nibleaf/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
