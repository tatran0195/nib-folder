{
  "name": "@nibleaf/importers",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Content import subsystem for Ghost and Mintlify into Nibleaf (Avkash architecture)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
